# For `docker-compose.yml` only — copy to `.env` in this same
# directory. This is separate from backend/.env (used for running
# the backend directly on your machine, outside Docker).
#
# Everything here has a working default baked into docker-compose.yml
# itself, so `docker compose up` works with zero setup for local/demo
# use. Only override these for anything beyond that.

# The Postgres superuser docker-compose's db container creates on
# first boot. Only ever used once, by docker/postgres-init.sh, to
# create the restricted POSTGRES_APP_USER role below — the app itself
# never connects as this user (see backend/.env.example for why).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

# The role the backend container actually connects as.
POSTGRES_APP_USER=edusync_app
POSTGRES_APP_PASSWORD=edusync_app_password

POSTGRES_DB=edusync_db

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend

JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_SHARED_SECRET=
JAZZCASH_PAYMENT_URL=
JAZZCASH_RETURN_URL=
