# This is a template, not a plain nginx config — nginx's own startup
# scripts run envsubst over any *.template file under
# /etc/nginx/templates/, substituting ${BACKEND_ORIGIN} with the real
# value at container start (see frontend/Dockerfile). Locally that's
# Docker Compose's internal DNS name for the backend service; on
# Render (no shared internal network between services) it's the
# backend service's own public HTTPS URL instead. Keeping the browser
# talking only to the frontend's own origin, with nginx forwarding
# /api/ server-side, means no CORS configuration is ever needed.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # The service worker itself must never be cached long-term, or
    # browsers won't pick up a new one after a deploy.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass ${BACKEND_ORIGIN}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: any route not matched above (and not a real
    # static file) resolves to index.html so React Router can handle
    # client-side navigation, direct links, and refreshes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
