# This is a template, not a plain nginx config — nginx's own startup
# scripts run envsubst over any *.template file under
# /etc/nginx/templates/, substituting ${BACKEND_ORIGIN} with the real
# value at container start (see frontend/Dockerfile). Locally that's
# Docker Compose's internal DNS name for the backend service; on
# Render (no shared internal network between services) it's the
# backend service's own public HTTPS URL instead. Keeping the browser
# talking only to the frontend's own origin, with nginx forwarding
# /api/ server-side, means no CORS configuration is ever needed.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # The service worker itself must never be cached long-term, or
    # browsers won't pick up a new one after a deploy.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass ${BACKEND_ORIGIN}/api/;

        # Both of these matter only when BACKEND_ORIGIN is https://, i.e.
        # when the backend is reached over the public internet rather
        # than a private Docker network — they're harmless no-ops for a
        # plain-http upstream, which is why a local/CI compose run can
        # never catch their absence.
        #
        # proxy_ssl_server_name: nginx omits TLS SNI by default. Hosts
        # that serve many apps behind shared IPs route by SNI, so without
        # it the handshake fails and every proxied call becomes a 502.
        proxy_ssl_server_name on;

        # $proxy_host (the upstream's own hostname) rather than $host
        # (this server's): the upstream edge routes on Host too, and it
        # is what the backend's ALLOWED_HOSTS must then contain. The real
        # client-facing host is still forwarded below.
        proxy_set_header Host $proxy_host;

        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: any route not matched above (and not a real
    # static file) resolves to index.html so React Router can handle
    # client-side navigation, direct links, and refreshes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
