# This file is for running the backend directly on your machine
# (manage.py runserver). Running everything via Docker instead? Use
# the root-level .env.example / docker-compose.yml — its db service
# creates this same POSTGRES_APP_USER role automatically, you don't
# fill any of this in by hand.

SECRET_KEY=
DEBUG=True

# POSTGRES_USER must be a non-superuser, non-BYPASSRLS role that
# owns the app's tables (PostgreSQL Row-Level Security is a no-op
# for superusers and table owners without FORCE ROW LEVEL SECURITY).
# See tenants/migrations/0002_row_level_security.py.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_SHARED_SECRET=
JAZZCASH_PAYMENT_URL=
JAZZCASH_RETURN_URL=
